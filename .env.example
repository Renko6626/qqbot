BOT_ADMIN_USER=admin
BOT_ADMIN_PASSWORD=replace-with-a-long-random-password
BOT_CONFIG_PATH=data/plugins.json
# Docker 内使用 SnowLuma 的容器网络名称，不填写公网管理域名。
BOT_ONEBOT_URL=ws://snowluma-ha3hckthz1jjytu0puicixro:3001
BOT_ONEBOT_TOKEN=replace-with-your-onebot-token
BOT_COOLIFY_URL=
PORT=8080

# DeepGHS 图片识别：ORT CPU，先 uv sync --extra nsfw 并下载ONNX模型。
BOT_DEEPGHS_MODEL_PATH=data/models/deepghs_rating/model.onnx
BOT_DEEPGHS_THREADS=1
# 自动监测命中图片的归档根目录，容器中应位于持久化的 /app/data 内。
BOT_DEEPGHS_ARCHIVE_DIR=data/anime_rating_hits
